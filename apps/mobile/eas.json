{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://dev.sendme.junoshon.cloud",
        "RCT_NEW_ARCH_ENABLED": "0"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://dev.sendme.junoshon.cloud",
        "RCT_NEW_ARCH_ENABLED": "0"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
